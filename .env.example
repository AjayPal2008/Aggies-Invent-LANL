# Copy to .env and fill in. Never commit .env. Keys stay on the server; the dashboards never see them.

# --- Core ---
# SQLite by default. For PostgreSQL (Neon, Supabase, Render free tiers):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
JWT_SECRET=replace-with-a-long-random-string
ALLOWED_EMAIL_DOMAINS=lanl.gov
ADMIN_EMAILS=admin@lanl.gov
DEMO_PASSWORD=demo1234
PUBLIC_URL=http://localhost:8000

# --- AI (Claude). Leave empty to run with built-in offline content. ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# --- Google sign-in (optional). Create an OAuth client ID at console.cloud.google.com ---
GOOGLE_CLIENT_ID=

# --- Data sources: "file" reads CSV/JSON exports from DATA_DIR, "live" calls the system ---
# DATA_DIR=backend/data/sample
DIRECTORY_MODE=file
DIRECTORY_API_URL=
DIRECTORY_API_TOKEN=
UTRAIN_MODE=file
UTRAIN_API_URL=
UTRAIN_API_TOKEN=
ORACLE_MODE=file
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=
# ORACLE_EMPLOYEE_QUERY=SELECT ... FROM hr_employees_v

# --- Uploaded documents and interview recordings ---
# UPLOAD_DIR=backend/uploads
MAX_UPLOAD_MB=60
# Interview-style assessments are scored 1-9; this is the pass mark
INTERVIEW_PASS=5.5

# --- Traffic safeguards (see docs/SCALABILITY.md) ---
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_MINUTE=10
AI_MAX_CONCURRENT=8
AI_BREAKER_FAILURES=5
AI_BREAKER_SECONDS=60
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10
# Docker stack only
# APP_REPLICAS=2
# WEB_CONCURRENCY=2
# NGINX_IP_RATE=300r/s
# NGINX_IP_CONNECTIONS=2000

# --- Source-grounded diagnostic (see ASSESSMENT_DEMO.md) ---
# DIAGNOSTIC_BANK_PATH=Resource_File/cache/assessment/bank.json
# Leave DIAGNOSTIC_DB_PATH empty to keep diagnostic sessions in the platform database (DATABASE_URL).
# DIAGNOSTIC_DB_PATH=
# Serve a built frontend bundle instead of the source folders (scripts/build_frontend.py)
# FRONTEND_DIR=dist

# --- Email reminders: preview (send nothing) | resend | smtp ---
EMAIL_MODE=preview
EMAIL_FROM=LANL Training <training@lanl.gov>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
